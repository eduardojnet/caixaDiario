# Copie para .env se quiser trocar as senhas locais. O arquivo .env esta no
# .gitignore: nenhuma credencial real entra no repositorio. Os valores abaixo
# servem apenas ao ambiente local; sem .env, o compose usa estes mesmos padroes.
LANCAMENTOS_DB_PASSWORD=lancamentos_admin_local
LANCAMENTOS_APP_PASSWORD=lancamentos_app_local
CONSOLIDADO_DB_PASSWORD=consolidado_admin_local
CONSOLIDADO_APP_PASSWORD=consolidado_app_local
BROKER_ADMIN_USER=caixadiario
BROKER_ADMIN_PASSWORD=caixadiario_local
BROKER_LANCAMENTOS_PASSWORD=lancamentos_broker_local
BROKER_CONSOLIDADO_PASSWORD=consolidado_broker_local
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
CAIXA_LOJA_SEGREDO=caixa-loja-segredo-local
CONTADOR_SEGREDO=contador-segredo-local
