<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CaixaDiario.Integracao.Tests</RootNamespace>
    <AssemblyName>CaixaDiario.Integracao.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- Mesma versao do Testcontainers.PostgreSql [NVI ate o restore passar]. -->
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.15.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CaixaDiario.Lancamentos.Api\CaixaDiario.Lancamentos.Api.csproj" />
    <ProjectReference Include="..\..\src\CaixaDiario.Consolidado.Api\CaixaDiario.Consolidado.Api.csproj" />
    <!-- O mesmo migrador do compose prepara o banco dos testes. -->
    <ProjectReference Include="..\..\src\CaixaDiario.Lancamentos.Migracoes\CaixaDiario.Lancamentos.Migracoes.csproj" />
    <ProjectReference Include="..\..\src\CaixaDiario.Consolidado.Migracoes\CaixaDiario.Consolidado.Migracoes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- O exemplo versionado do contrato e o script de permissoes do broker. -->
    <None Include="..\..\docs\contratos\*.json" LinkBase="contratos" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\infra\rabbitmq\permissoes.sh" LinkBase="infra" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
